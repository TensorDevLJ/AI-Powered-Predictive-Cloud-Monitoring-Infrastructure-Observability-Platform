# ==========================================
# Cloud Monitoring System - Backend Config
# ==========================================
# Copy this file to `.env` in the backend/ directory and fill in real values.
#   cp .env.example .env

# Application
APP_NAME=Cloud Monitoring System
APP_VERSION=1.0.0
DEBUG=False

# Security
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Default (zero-config, good for local dev):
DATABASE_URL=sqlite:///./monitoring.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/cloud_monitor
# PostgreSQL example (used by docker-compose.yml):
# DATABASE_URL=postgresql://monitoring_user:monitoring_password@localhost:5432/monitoring

# Prometheus / Grafana / Alertmanager
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
ALERTMANAGER_URL=http://localhost:9093

# Email Alerts (optional - leave blank to disable email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@monitoring.com
ALERT_EMAIL_TO=admin@example.com

# Monitoring Thresholds (percent)
CPU_THRESHOLD=80.0
MEMORY_THRESHOLD=85.0
DISK_THRESHOLD=90.0

# Metrics Collection
METRICS_SCRAPE_INTERVAL=15
METRICS_RETENTION_DAYS=30

# CORS - comma-separated list is NOT supported by default (list type in Settings);
# edit CORS_ORIGINS directly in app/config.py if you need more than the defaults.
